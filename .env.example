# Copy to .env and fill in the two keys. Everything else has a working default.

# --- Required -----------------------------------------------------------------
# Groq API key (LLM that generates and validates answers): https://console.groq.com/keys
GROQ_API_KEY=
# Pinecone API key (vector DB + hosted embedding model; free Starter plan works):
# https://app.pinecone.io
PINECONE_API_KEY=

# --- Pinecone -----------------------------------------------------------------
PINECONE_INDEX_NAME=agentic-ai-ebook
PINECONE_NAMESPACE=agentic-ai-ebook
# The free Starter plan only supports aws / us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings (Pinecone Inference) ------------------------------------------
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# --- LLM ----------------------------------------------------------------------
# groq (default) | anthropic. Each provider needs its own key.
LLM_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-120b, anthropic: claude-opus-5-5).
LLM_MODEL=
# low | medium | high (| xhigh | max on Claude). Maps to reasoning effort on gpt-oss.
LLM_EFFORT=medium
# Grounding validator (LLM judge). Empty = provider default
# (groq: openai/gpt-oss-20b, anthropic: same as LLM_MODEL).
VALIDATOR_MODEL=
VALIDATOR_EFFORT=low
LLM_TIMEOUT_SECONDS=120
# Only needed with LLM_PROVIDER=anthropic: https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Retrieval ----------------------------------------------------------------
TOP_K=5
# Minimum cosine similarity for a chunk to be sent to the LLM; if none pass, the API
# returns the fallback. Value for llama-text-embed-v2, from scripts/evaluate.py.
RETRIEVAL_THRESHOLD=0.33
# Similarity that the confidence heuristic maps to 1.0.
CONFIDENCE_SCORE_CEILING=0.70

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Document -----------------------------------------------------------------
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PDF_PATH=data/raw/Ebook-Agentic-AI.pdf

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text
